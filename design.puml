@startuml CPU Scheduling Simulation Architecture

' Style definitions
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing false
skinparam classFontStyle bold
skinparam packageStyle rectangle
skinparam linetype ortho

' Title
title CPU Scheduling Algorithms Simulation - Architecture Design

' Backend Package
package "Backend" {
  ' Process Classes
  class Process {
    - pid: int
    - arrival_time: int
    - burst_time: int
    - priority: int
    - remaining_time: int
    - start_time: int
    - completion_time: int
    - waiting_time: int
    - turnaround_time: int
    - response_time: int
    + __init__(pid, arrival, burst, priority)
    + calculate_metrics(): void
    + set_completion_time(time): void
    + set_start_time(time): void
    + get_waiting_time(): int
    + get_turnaround_time(): int
    + get_response_time(): int
    + get_remaining_time(): int
    + decrease_remaining_time(time): void
  }
  
  class ProcessGenerator {
    + generate_random_processes(count, arrival_range, burst_range, priority_range): List<Process>
    + load_processes_from_file(file_path): List<Process>
    + validate_processes(processes): boolean
  }

  ' Scheduler Classes
  abstract class Scheduler {
    # processes: List<Process>
    # current_time: int
    # gantt_chart: List<Tuple>
    # execution_history: List<Dict>
    + __init__(processes)
    + {abstract} run(): void
    + get_performance_metrics(): Dict
    + get_gantt_chart(): List<Tuple>
    + get_execution_history(): List<Dict>
    # record_state(state): void
    # calculate_metrics(): Dict
  }

  class FCFSScheduler {
    + run(): void
    - sort_by_arrival_time(): void
  }

  class SJFScheduler {
    + run(): void
    - sort_by_burst_time(): void
    - find_shortest_job(ready_queue): Process
  }

  class PriorityScheduler {
    + run(): void
    - sort_by_priority(): void
    - find_highest_priority(ready_queue): Process
  }

  class RoundRobinScheduler {
    - time_quantum: int
    + __init__(processes, time_quantum)
    + run(): void
    - handle_context_switch(ready_queue): void
  }

  class PriorityRRScheduler {
    - time_quantum: int
    - priority_queues: Dict<int, List<Process>>
    + __init__(processes, time_quantum)
    + run(): void
    - initialize_priority_queues(): void
    - process_priority_level(priority, queue): void
  }
  
  class SimulationController {
    - scheduler_factory: Dict<str, Class>
    + run_simulation(algorithm, processes, params): Dict
    + compare_algorithms(processes, algorithms, params): Dict
    + get_step_by_step_execution(algorithm, processes, params): List<Dict>
    - create_scheduler(algorithm, processes, params): Scheduler
  }

  ' Relationships
  Scheduler <|-- FCFSScheduler
  Scheduler <|-- SJFScheduler
  Scheduler <|-- PriorityScheduler
  Scheduler <|-- RoundRobinScheduler
  Scheduler <|-- PriorityRRScheduler
  
  Scheduler "1" o-- "many" Process : contains >
  SimulationController --> Scheduler : creates >
  SimulationController --> ProcessGenerator : uses >
}

' Frontend Package
package "Frontend" {
  ' Vue Components
  class App {
    - components: Dict
    - data(): Object
    - methods: Object
  }
  
  class AlgorithmSelector {
    - algorithms: Array
    - selectedAlgorithm: String
    + data(): Object
    + methods: {selectAlgorithm}
    + emits: ['algorithm-selected']
  }
  
  class GanttChart {
    - ganttData: Array
    - width: Number
    - height: Number
    + props: ['data']
    + mounted(): void
    + methods: {renderChart}
  }
  
  class ProcessTable {
    - processes: Array
    - columns: Array
    + props: ['processes']
    + methods: {addProcess, editProcess, removeProcess}
    + emits: ['process-updated']
  }
  
  class PerformanceMetrics {
    - metrics: Object
    + props: ['metrics']
    + computed: {formattedMetrics}
  }
  
  class InteractiveVisualizer {
    - executionHistory: Array
    - currentStep: Number
    - isPlaying: Boolean
    + props: ['history']
    + methods: {nextStep, prevStep, play, pause}
  }
  
  ' Vue Views
  class HomeView {
    - components: {HelloWorld}
  }
  
  class ProcessesView {
    - processes: Array
    - components: {ProcessTable, ProcessGenerator}
    + methods: {saveProcesses, generateRandom, loadFromFile}
  }
  
  class VisualizationView {
    - algorithm: String
    - processes: Array
    - ganttChart: Array
    - metrics: Object
    - components: {AlgorithmSelector, GanttChart, PerformanceMetrics}
    + methods: {runSimulation, updateAlgorithm}
  }
  
  class ComparisonView {
    - algorithms: Array
    - processes: Array
    - results: Object
    - components: {PerformanceMetrics, GanttChart}
    + methods: {compareAlgorithms, exportResults}
  }
  
  ' API Service
  class ApiService {
    + runSimulation(algorithm, processes, params): Promise
    + compareAlgorithms(processes, algorithms, params): Promise
    + getStepByStepExecution(algorithm, processes, params): Promise
  }
  
  ' Relationships
  App --> HomeView : routes to >
  App --> ProcessesView : routes to >
  App --> VisualizationView : routes to >
  App --> ComparisonView : routes to >
  
  VisualizationView --> AlgorithmSelector : contains >
  VisualizationView --> GanttChart : contains >
  VisualizationView --> PerformanceMetrics : contains >
  
  ProcessesView --> ProcessTable : contains >
  
  ComparisonView --> PerformanceMetrics : contains >
  ComparisonView --> GanttChart : contains >
  
  ApiService --> App : used by >
  VisualizationView --> ApiService : uses >
  ComparisonView --> ApiService : uses >
  ProcessesView --> ApiService : uses >
}

' Integration Between Frontend and Backend
ApiService ..> SimulationController : HTTP Requests >

@enduml